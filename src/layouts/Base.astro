---
import { CHANNELS } from '../lib/channels';
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- ?v= busts browsers' sticky favicon cache; bump it whenever the icon changes -->
		<link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon.png?v=2')} />
		<link rel="icon" href={withBase('/favicon.ico?v=2')} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
	</head>
	<body>
		<nav aria-label="Channels" class="sr-only">
			<ul>
				{CHANNELS.map((c) => (
					<li><a href={withBase(c.path)}>{c.label}</a></li>
				))}
			</ul>
		</nav>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--screen-bg: #0f1a30;
		--screen-bg-raised: #17274a;
		--screen-text: #e6ecf8;
		--screen-muted: #9fb0cf;
		--screen-accent: #ffcf8a;
		--screen-border: #2b3f6b;
		--screen-font-body: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
		--screen-font-mono: ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace;
		--screen-measure: 70ch;
	}
	*, *::before, *::after { box-sizing: border-box; }
	body {
		margin: 0;
		background: var(--screen-bg);
		color: var(--screen-text);
		font-family: var(--screen-font-body);
		font-size: 1.125rem;
		line-height: 1.65;
	}
	a { color: var(--screen-accent); }
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
		border: 0;
	}
</style>
