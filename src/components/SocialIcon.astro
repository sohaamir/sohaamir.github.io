---
import type { SocialIconName } from '../lib/socials';
/**
 * Small inline-SVG icons (no icon pack dependency): brand marks for the contact
 * links, and pdf / code / link / doi / quote for the publication action bars.
 * `mono` draws the LinkedIn and ORCID marks in currentColor (for the dark navbar).
 */
interface Props {
	name: SocialIconName | 'pdf' | 'code' | 'link' | 'doi' | 'quote';
	mono?: boolean;
}
const { name, mono = false } = Astro.props;
const knockout = mono ? 'var(--nav)' : '#fff';
---

{name === 'github' && (
	<svg viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
)}
{name === 'x' && (
	<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z" /></svg>
)}
{name === 'linkedin' && (
	<svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill="currentColor" /><text x="12" y="17.5" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="14" fill={knockout}>in</text></svg>
)}
{name === 'orcid' && (
	<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill={mono ? 'currentColor' : '#a6ce39'} /><text x="12" y="16.5" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="11" fill={knockout}>iD</text></svg>
)}
{name === 'bluesky' && (
	<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5.2 3.4c2.5 1.9 5.2 5.7 6.8 7.7 1.6-2 4.3-5.8 6.8-7.7 1.8-1.3 4.7-2.4 4.7.9 0 .7-.4 5.5-.6 6.3-.8 2.8-3.6 3.5-6.1 3.1 4.4.8 5.5 3.3 3.1 5.8-4.6 4.7-6.6-1.2-7.1-2.7l-.8-2.1-.8 2.1c-.5 1.5-2.5 7.4-7.1 2.7-2.4-2.5-1.3-5 3.1-5.8-2.5.4-5.3-.3-6.1-3.1C.9 9.8.5 5 .5 4.3c0-3.3 2.9-2.2 4.7-.9z" /></svg>
)}
{name === 'researchgate' && (
	<svg viewBox="0 0 24 24" aria-hidden="true"><rect width="24" height="24" rx="4" fill={mono ? 'currentColor' : '#00ccbb'} /><text x="12" y="16.5" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="11" fill={knockout}>RG</text></svg>
)}
{name === 'osf' && (
	<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill={mono ? 'currentColor' : '#2a6c9b'} /><text x="12" y="15.5" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="8.5" fill={knockout}>OSF</text></svg>
)}
{name === 'email' && (
	<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><rect x="2" y="4.5" width="20" height="15" rx="2" /><path d="m3 6 9 7 9-7" /></svg>
)}
{name === 'pdf' && (
	<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><path d="M14 2v6h6M8 13h8M8 17h5" /></svg>
)}
{name === 'code' && (
	<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" /></svg>
)}
{name === 'link' && (
	<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>
)}
{name === 'doi' && (
	<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="currentColor" /><text x="12" y="15.5" text-anchor="middle" font-family="Arial, sans-serif" font-weight="700" font-size="9" fill="#fff">doi</text></svg>
)}
{name === 'quote' && (
	<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M4 18h5l2-5V6H4v7h3zM13 18h5l2-5V6h-7v7h3z" /></svg>
)}

<style>
	svg { width: 1.35rem; height: 1.35rem; flex: none; display: block; }
</style>
