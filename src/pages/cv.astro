---
import Channel from '../layouts/Channel.astro';
import { withBase } from '../lib/url';

const pdf = withBase('/assets/pdf/academic_cv.pdf');
---

<Channel channel="cv" title="cv · Aamir Sohail">
	<p class="actions"><a class="btn" href={pdf} download>Download CV (PDF)</a> <a href={pdf} target="_blank" rel="noopener">open in a new tab</a></p>
	<object class="embed" data={pdf} type="application/pdf" aria-label="Academic CV (PDF)">
		<p>Your browser cannot display the PDF here. <a href={pdf}>Open the CV as a PDF</a>.</p>
	</object>
</Channel>

<style>
	.embed { display: block; width: 100%; height: 75vh; border: 1px solid var(--rule); border-radius: var(--radius); box-shadow: 0 1px 3px rgba(31, 35, 40, 0.08); }
	.actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin: 0 0 1.25rem; }
	@media (max-width: 700px) {
		.embed { display: none; }
	}
</style>
